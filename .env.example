# Database Configuration
POSTGRES_DB=judicial_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Neo4j Configuration
NEO4J_AUTH=neo4j/password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Service URLs
BGE_M3_URL=http://bge_m3:8001
BGE_RERANKER_URL=http://bge_reranker:8002
JAIS_URL=http://jais:8003
FALLBACK_MODEL_URL=http://fallback_model:8004
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_PRIMARY=jais:13b-chat
OLLAMA_MODEL_FALLBACK=phi3:mini
OLLAMA_TIMEOUT_SECONDS=60
ENABLE_SPARSE_SEARCH=false

# Application Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEBUG=true

